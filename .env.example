# Nothing is required: accounts, sync between devices and push notifications use KROOPY's own cloud,
# deployed with the app (netlify/functions). These are optional.

# Use Supabase instead of the built-in cloud (Supabase → Project Settings → API; anon key only, never service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Point the app at a KROOPY cloud on another address (default: /api on the same site).
VITE_CLOUD_URL=

# ── KROOPY AI (set these in Netlify → Project configuration → Environment variables, scope "Functions").
# Never put them in a VITE_ variable: those end up in the browser.
# OPENAI_API_KEY=            # from platform.openai.com → API keys (secret)
# KROOPY_AI_DAILY_USD=0.5    # per-account daily limit (estimate), default 0.5
# KROOPY_AI_MONTHLY_USD=6    # per-account monthly limit (estimate), default 6
# KROOPY_AI_MODEL_CHAT=      # pin a model (default: newest GPT "terra" the key can use)
# KROOPY_AI_MODEL_DEEP=      # pin a model for "Think deeper" (default: newest "sol")
