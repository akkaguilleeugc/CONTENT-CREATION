# Nothing is required: accounts, sync between devices and push notifications use KROOPY's own cloud,
# deployed with the app (netlify/functions). These are optional.

# Use Supabase instead of the built-in cloud (Supabase → Project Settings → API; anon key only, never service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Point the app at a KROOPY cloud on another address (default: /api on the same site).
VITE_CLOUD_URL=
